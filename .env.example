# Copia in .env (non committarlo) oppure imposta queste variabili sul provider.

# Obbligatorio: token di @BotFather
TELEGRAM_TOKEN=

# Postgres (es. Neon). Se assente il bot usa uno storage in memoria.
DATABASE_URL=

# URL pubblico del servizio (es. https://<app>-<org>.koyeb.app).
# Se assente il bot usa il long polling (comodo in locale).
WEBHOOK_BASE_URL=

# Facoltativi
# WEBHOOK_SECRET=        # default: derivato dal token
# OPENWEATHERMAP_API_KEY= # senza chiave /comune non mostra il meteo
# PORT=8000
# BOT_TIMEZONE=Europe/Rome
